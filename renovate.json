{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>isityael/infra//.github/renovate/base.json",
    "config:best-practices",
    ":preserveSemverRanges"
  ],
  "baseBranchPatterns": [
    "isityael/dhi-hardening"
  ],
  "enabledManagers": [
    "gomod",
    "dockerfile",
    "github-actions",
    "woodpecker",
    "custom.regex"
  ],
  "github-actions": {
    "managerFilePatterns": [
      "/(^|/)\\.github/workflows/.*\\.ya?ml$/",
      "/(^|/)\\.forgejo/workflows/.*\\.ya?ml$/"
    ]
  },
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the pinned GeeseFS release used by production and test images",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/",
        "/(^|/)test/Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) packageName=(?<packageName>[^\\s]+)\\nARG GEESEFS_VERSION=(?<currentValue>v[^\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Track GeeseFS dependency security overrides",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>go) packageName=(?<packageName>golang\\.org/x/crypto)\\nARG GEESEFS_X_CRYPTO_VERSION=(?<currentValue>v[^\\s]+)",
        "# renovate: datasource=(?<datasource>go) packageName=(?<packageName>golang\\.org/x/net)\\nARG GEESEFS_X_NET_VERSION=(?<currentValue>v[^\\s]+)",
        "# renovate: datasource=(?<datasource>go) packageName=(?<packageName>google\\.golang\\.org/grpc)\\nARG GEESEFS_GRPC_VERSION=(?<currentValue>v[^\\s]+)",
        "# renovate: datasource=(?<datasource>go) packageName=(?<packageName>golang\\.org/x/text)\\nARG GEESEFS_X_TEXT_VERSION=(?<currentValue>v[^\\s]+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Label Go dependency updates",
      "matchManagers": [
        "gomod"
      ],
      "addLabels": [
        "dependencies",
        "go"
      ],
      "constraintsFiltering": "strict"
    },
    {
      "description": "Keep Docker and CI updates reviewable",
      "matchManagers": [
        "dockerfile",
        "github-actions",
        "woodpecker",
        "custom.regex"
      ],
      "addLabels": [
        "dependencies",
        "supply-chain"
      ]
    },
    {
      "description": "Use container version tags only.",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": false
    },
    {
      "description": "Do not create container digest pins or digest refreshes.",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "enabled": false
    },
    {
      "description": "One reviewed weekly dependency refresh, including majors, charts, images and tooling.",
      "matchPackageNames": [
        "*"
      ],
      "groupName": "weekly dependencies",
      "groupSlug": "weekly-dependencies",
      "groupSingleUpdates": true,
      "minimumGroupSize": 1,
      "additionalBranchPrefix": "",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMajor": false,
      "separateMultipleMinor": false,
      "schedule": [
        "* 0-5 * * 1"
      ],
      "automerge": false
    }
  ],
  "pinDigests": false,
  "ignorePresets": [
    "docker:pinDigests"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 0-5 * * 1"
  ],
  "separateMajorMinor": false,
  "separateMinorPatch": false,
  "separateMultipleMajor": false,
  "separateMultipleMinor": false,
  "prConcurrentLimit": 1,
  "automerge": false,
  "lockFileMaintenance": {
    "enabled": false
  }
}
